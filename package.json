{
  "name": "slow-start",
  "version": "0.0.0",
  "description": "TypeScript rate limiter that ramps up gradually after idle periods, so cold systems are not hit at full throughput.",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc",
    "build": "tsdown",
    "check:package": "npm run build && publint && attw --pack .",
    "lint": "eslint .",
    "test:smoke": "npm run build && node scripts/smoke-test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srivathsav01/slow-start.git"
  },
  "keywords": [],
  "author": "Srivathsav",
  "license": "Apache-2.0",
  "type": "module",
  "bugs": {
    "url": "https://github.com/srivathsav01/slow-start/issues"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "homepage": "https://github.com/srivathsav01/slow-start#readme",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.3",
    "eslint": "^10.10.0",
    "fast-check": "^4.10.2",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
