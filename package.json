{
  "name": "slow-start",
  "version": "0.3.0",
  "description": "Warm-up rate limiter for Node.js and TypeScript: ramps up gradually after idle periods so cold caches and pools are not hit at full throughput. Guava SmoothWarmingUp, zero dependencies.",
  "keywords": [
    "rate-limiter",
    "rate-limiting",
    "ratelimit",
    "throttle",
    "throttling",
    "warmup",
    "warm-up",
    "cold-start",
    "slow-start",
    "smoothwarmingup",
    "guava",
    "backpressure",
    "token-bucket",
    "leaky-bucket",
    "nodejs",
    "typescript",
    "express",
    "fastify",
    "koa",
    "middleware"
  ],
  "license": "Apache-2.0",
  "author": "Srivathsav01 (https://github.com/srivathsav01)",
  "homepage": "https://github.com/srivathsav01/slow-start#readme",
  "bugs": {
    "url": "https://github.com/srivathsav01/slow-start/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srivathsav01/slow-start.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./adapters": {
      "import": {
        "types": "./dist/adapters.d.mts",
        "default": "./dist/adapters.mjs"
      },
      "require": {
        "types": "./dist/adapters.d.cts",
        "default": "./dist/adapters.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "adapters": [
        "./dist/adapters.d.cts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc",
    "build": "tsdown",
    "check:package": "npm run build && publint && attw --pack .",
    "lint": "eslint .",
    "test:smoke": "npm run build && node scripts/smoke-test.mjs",
    "bench": "npm run build && node bench/run.mjs && node bench/plot.mjs",
    "bench:perf": "npm run build && node --expose-gc bench/perf.mjs",
    "prepack": "node scripts/swap-readme.mjs swap",
    "postpack": "node scripts/swap-readme.mjs restore"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/koa": "^3.0.3",
    "@types/node": "^22.20.3",
    "eslint": "^10.10.0",
    "express": "^5.2.1",
    "fast-check": "^4.10.2",
    "fastify": "^5.12.5",
    "koa": "^3.2.1",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
